---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import SectionHeading from '../components/sections/SectionHeading.astro';
import FeatureCard from '../components/ui/FeatureCard.astro';
import ProcessSteps from '../components/sections/ProcessSteps.astro';
import PullQuote from '../components/sections/PullQuote.astro';
import CTABand from '../components/sections/CTABand.astro';
import { buildWebPageSchema } from '../utils/schema';

const schema = buildWebPageSchema(
  'Leistungen | Axiom Medical Transfer',
  'https://www.axiom-medical-transfer.de/leistungen',
  'Exklusive medizinische Einzeltransfers für Praxen, Kliniken und Patienten in Düsseldorf, Meerbusch, Ratingen, Neuss und Köln.',
);

const personIcon = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`;

const phoneIcon = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.8 19.79 19.79 0 01.02 1.18 2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92v2z"/></svg>`;

const heartIcon = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>`;

const cooperationSteps = [
  {
    number: '1',
    title: 'Terminübermittlung',
    description: 'Die Praxis übermittelt Termin, Abholadresse und die notwendigen Patienteninformationen.',
  },
  {
    number: '2',
    title: 'Organisation',
    description: 'Axiom Medical Transfer übernimmt die vollständige Koordination — Fahrer, Fahrzeug, Zeitplanung.',
  },
  {
    number: '3',
    title: 'Abholung & Begleitung',
    description: 'Der Patient wird pünktlich abgeholt und sicher sowie diskret zum Ziel begleitet.',
  },
  {
    number: '4',
    title: 'Rückfahrt',
    description: 'Nach dem Termin wird der Patient zuverlässig nach Hause oder an den gewünschten Ort gebracht.',
  },
];

const checklistItems = [
  'Exklusive medizinische Einzeltransfers',
  'Direkte Fahrten ohne Mitfahrende',
  'Kooperationen mit Praxen und Kliniken',
  'Fahrzeug: Mercedes-Benz V-Klasse',
  'Geschulte Fahrer für sensible Situationen',
  'Erfrischungen bei jeder Fahrt inklusive',
  'Absolute Vertraulichkeit',
  'Persönlicher Ansprechpartner für Einrichtungen',
];
---

<BaseLayout
  title="Leistungen | Axiom Medical Transfer"
  description="Exklusive medizinische Einzeltransfers für Praxen, Kliniken und Patienten in Düsseldorf und Umgebung. Diskret, zuverlässig, persönlich."
  schema={schema}
>
  <!-- Hero -->
  <PageHero
    label="Leistungen"
    heading="Individuell organisiert. Persönlich begleitet."
    subheading="Axiom Medical Transfer führt ausschließlich individuelle medizinische Einzeltransfers durch. Jeder Auftrag wird individuell vorbereitet und auf den jeweiligen Termin abgestimmt."
  />

  <!-- Philosophy Block -->
  <section class="section" style="background-color: var(--color-pearl);">
    <div class="container">
      <div class="max-w-[800px]">
        <SectionHeading
          label="Unser Ansatz"
          heading="Ausschließlich für Sie."
          align="left"
        />
        <div class="mt-8 space-y-5">
          <p class="text-lg leading-relaxed" style="color: var(--color-navy); opacity: 0.85;">
            Es gibt keine Sammelfahrten, keine wechselnden Mitfahrenden, keine standardisierten Abläufe. Der gesamte Transfer gehört ausschließlich dem jeweiligen Patienten.
          </p>
          <p class="text-lg leading-relaxed" style="color: var(--color-navy); opacity: 0.75;">
            Das schafft einen ruhigen und verlässlichen Rahmen — sowohl für Patienten als auch für die Einrichtungen, die mit uns zusammenarbeiten. Keine Wartezeiten. Keine Ablenkungen. Keine unnötige Aufmerksamkeit.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 Feature Cards (navy bg) -->
  <section class="section" style="background-color: #1B2B4B;">
    <div class="container">
      <SectionHeading
        label="Was wir bieten"
        heading="Unsere Kernleistungen"
        light={true}
        align="left"
      />
      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
        <FeatureCard
          icon={personIcon}
          title="Exklusiver Einzeltransfer"
          body="Jeder Transfer findet ausschließlich für eine Person statt. Keine weiteren Fahrgäste, keine zusätzlichen Stopps — der gesamte Ablauf ist auf den Patienten ausgerichtet."
          variant="dark"
        />
        <FeatureCard
          icon={phoneIcon}
          title="Persönlich organisiert"
          body="Abholort, Uhrzeit und Ablauf werden im Voraus koordiniert. Für Praxen und Kliniken steht ein fester Ansprechpartner für die Logistik zur Verfügung."
          variant="dark"
        />
        <FeatureCard
          icon={heartIcon}
          title="Ausstattung & Komfort"
          body="Erfrischungen sind bei jeder Fahrt inklusive. Zusätzliche Ausstattungen können individuell nach Absprache bereitgestellt werden."
          variant="dark"
        />
      </div>
    </div>
  </section>

  <!-- Checklist (pearl bg) -->
  <section class="section" style="background-color: var(--color-pearl);">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div>
          <SectionHeading
            label="Im Leistungsumfang"
            heading="Im Leistungsumfang enthalten"
            align="left"
          />
          <p class="mt-4 text-base leading-relaxed" style="color: var(--color-muted);">
            Jeder Transfer umfasst standardmäßig die folgenden Leistungen — transparent und ohne versteckte Zusatzkosten.
          </p>
        </div>
        <div>
          <ul class="checklist space-y-1 mt-2">
            {checklistItems.map((item) => (
              <li style="color: var(--color-navy);">{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- B2B Cooperation (navy bg) -->
  <section class="section" style="background-color: #1B2B4B;">
    <div class="container">
      <div class="max-w-[720px]">
        <span class="label-tag-light">Für Kooperationen</span>
        <h2 class="section-heading text-white mt-4 mb-6">
          Ihr Anspruch endet nicht an der Praxistür.
        </h2>
        <p class="text-white/75 text-lg leading-relaxed mb-6">
          Die Fahrt von einem medizinischen Termin zurück nach Hause ist für Patienten eine sehr persönliche und sensible Situation. Mit Axiom Medical Transfer können Praxen und Kliniken ihren Patienten für diese Phase einen verlässlichen Rahmen anbieten — ohne zusätzlichen Organisationsaufwand im Praxisalltag.
        </p>
        <p class="text-white/60 leading-relaxed">
          Wir übernehmen die gesamte Logistik und stellen sicher, dass Ihre Patienten sicher, diskret und komfortabel ihr Ziel erreichen.
        </p>
      </div>
    </div>
  </section>

  <!-- Process Steps (pearl bg) -->
  <section class="section" style="background-color: var(--color-pearl);">
    <div class="container">
      <SectionHeading
        label="Kooperation"
        heading="So funktioniert eine Kooperation"
        subheading="Ein fester Ansprechpartner steht jeder Einrichtung zur Verfügung. Alle Informationen zu Patienten, Terminen und Einrichtungen werden mit absoluter Vertraulichkeit behandelt."
        align="left"
      />
      <div class="mt-12">
        <ProcessSteps steps={cooperationSteps} />
      </div>
    </div>
  </section>

  <!-- Pull Quote (navy) -->
  <PullQuote
    quote="Jeder Transfer wird so sorgfältig vorbereitet wie der Termin selbst."
    subtext="Sprechen Sie uns an — wir koordinieren alle Details im Voraus."
    light={true}
  />

  <!-- CTA Band -->
  <CTABand
    heading="Kooperation anfragen"
    subheading="Wir koordinieren alle Details im Voraus — unkompliziert und ohne Mehraufwand für Ihre Einrichtung."
    ctaPrimary={{ text: 'Jetzt Kontakt aufnehmen', href: '/kontakt' }}
    ctaSecondary={{ text: 'Über uns', href: '/ueber-uns' }}
  />
</BaseLayout>
