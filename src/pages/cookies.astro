---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
---

<BaseLayout
  title="Cookie-Einstellungen | Axiom Medical Transfer"
  description="Verwalten Sie Ihre Cookie-Einstellungen für axiom-medical-transfer.de."
  noindex={true}
>
  <PageHero
    label="Datenschutz"
    heading="Cookie-Einstellungen"
    subheading="Hier können Sie jederzeit Ihre Einwilligungen verwalten und anpassen."
  />

  <section class="section" style="background-color: var(--color-pearl);">
    <div class="container">
      <div
        class="max-w-[680px]"
        x-data="cookieSettings()"
        x-init="loadPrefs()"
      >

        <!-- Info text -->
        <p class="text-base leading-relaxed mb-10" style="color: var(--color-muted);">
          Wir verwenden Cookies und lokalen Browser-Speicher, um Ihnen eine optimale Website-Erfahrung zu bieten. Einige davon sind technisch notwendig. Andere helfen uns, externe Inhalte wie Karten anzuzeigen. Ihre Auswahl wird in Ihrem Browser gespeichert und kann jederzeit geändert werden.
        </p>

        <!-- Category rows -->
        <div class="space-y-4">

          <!-- Notwendig -->
          <div class="card-white p-6">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-1.5">
                  <h3 class="font-sans font-semibold text-base" style="color: var(--color-navy);">
                    Notwendige Cookies
                  </h3>
                  <span class="text-xs px-2 py-0.5 rounded-full font-medium" style="background: rgba(27,43,75,0.08); color: var(--color-navy);">Immer aktiv</span>
                </div>
                <p class="text-sm leading-relaxed" style="color: var(--color-muted);">
                  Diese Cookies sind für den technischen Betrieb der Website erforderlich. Sie speichern Ihre Cookie-Einstellungen lokal im Browser und können nicht deaktiviert werden.
                </p>
                <p class="text-xs mt-2" style="color: var(--color-muted);">
                  Gespeicherter Schlüssel: <code class="font-mono text-xs px-1 py-0.5 rounded" style="background: rgba(27,43,75,0.07);">axiom_cookie_consent</code>
                </p>
              </div>
              <label class="cookie-toggle flex-shrink-0 mt-1" aria-label="Notwendige Cookies (immer aktiv)">
                <input type="checkbox" checked disabled />
                <span class="cookie-toggle-slider"></span>
              </label>
            </div>
          </div>

          <!-- Funktional -->
          <div class="card-white p-6">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1">
                <h3 class="font-sans font-semibold text-base mb-1.5" style="color: var(--color-navy);">
                  Funktionale Cookies
                </h3>
                <p class="text-sm leading-relaxed" style="color: var(--color-muted);">
                  Diese Cookies ermöglichen die Einbindung externer Dienste. Konkret: Google Maps auf der Kontaktseite. Wenn Sie diese Cookies aktivieren, werden Daten an Google übertragen. Mehr dazu in unserer <a href="/datenschutz" class="underline" style="color: var(--color-navy);">Datenschutzerklärung</a>.
                </p>
                <p class="text-xs mt-2" style="color: var(--color-muted);">
                  Anbieter: Google Ireland Limited · Zweck: Karteneinbindung
                </p>
              </div>
              <label class="cookie-toggle flex-shrink-0 mt-1" aria-label="Funktionale Cookies aktivieren">
                <input type="checkbox" x-model="prefs.functional" />
                <span class="cookie-toggle-slider"></span>
              </label>
            </div>
          </div>

          <!-- Analyse -->
          <div class="card-white p-6">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-1.5">
                  <h3 class="font-sans font-semibold text-base" style="color: var(--color-navy);">
                    Analyse-Cookies
                  </h3>
                  <span class="text-xs px-2 py-0.5 rounded-full font-medium" style="background: rgba(27,43,75,0.05); color: var(--color-muted);">Derzeit nicht aktiv</span>
                </div>
                <p class="text-sm leading-relaxed" style="color: var(--color-muted);">
                  Analyse-Dienste sind auf dieser Website derzeit nicht eingebunden. Sollten sie in Zukunft verwendet werden, informieren wir Sie vorab und holen Ihre Einwilligung ein.
                </p>
              </div>
              <label class="cookie-toggle flex-shrink-0 mt-1" aria-label="Analyse-Cookies (nicht verfügbar)">
                <input type="checkbox" disabled />
                <span class="cookie-toggle-slider"></span>
              </label>
            </div>
          </div>
        </div>

        <!-- Action buttons -->
        <div class="flex flex-wrap gap-3 mt-8">
          <button
            @click="savePrefs()"
            class="btn-primary"
          >
            Einstellungen speichern
          </button>
          <button
            @click="acceptAll()"
            class="btn-ghost-dark"
          >
            Alle akzeptieren
          </button>
          <button
            @click="rejectAll()"
            class="btn-ghost-dark"
          >
            Nur Notwendige
          </button>
        </div>

        <!-- Success message -->
        <div
          x-show="saved"
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 translate-y-2"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-cloak
          class="mt-5 flex items-center gap-2.5 px-4 py-3 rounded-lg"
          style="background: rgba(27,43,75,0.06); color: var(--color-navy);"
          role="status"
          aria-live="polite"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
          <span class="text-sm font-medium font-sans">Einstellungen gespeichert.</span>
        </div>

        <p class="text-xs mt-8 leading-relaxed" style="color: var(--color-muted);">
          Ihre Einstellungen werden ausschließlich lokal in Ihrem Browser gespeichert und nicht an uns übertragen. Mehr Informationen finden Sie in unserer <a href="/datenschutz" class="underline" style="color: var(--color-navy);">Datenschutzerklärung</a>.
        </p>

      </div>
    </div>
  </section>
</BaseLayout>

<script>
function cookieSettings() {
  return {
    prefs: { necessary: true, functional: false, analytics: false },
    saved: false,
    loadPrefs() {
      try {
        const stored = localStorage.getItem('axiom_cookie_consent');
        if (stored) {
          const parsed = JSON.parse(stored);
          this.prefs = { necessary: true, functional: !!parsed.functional, analytics: false };
        }
      } catch {}
    },
    save(prefs) {
      const data = {
        ...prefs,
        necessary: true,
        version: 1,
        timestamp: new Date().toISOString(),
      };
      localStorage.setItem('axiom_cookie_consent', JSON.stringify(data));
      window.dispatchEvent(new CustomEvent('cookie-consent-saved', { detail: data }));
      this.saved = true;
      setTimeout(() => { this.saved = false; }, 4000);
    },
    savePrefs() { this.save(this.prefs); },
    acceptAll() {
      this.prefs = { necessary: true, functional: true, analytics: false };
      this.save(this.prefs);
    },
    rejectAll() {
      this.prefs = { necessary: true, functional: false, analytics: false };
      this.save(this.prefs);
    },
  };
}
</script>
