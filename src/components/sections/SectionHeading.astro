---
interface Props {
  label: string;
  heading: string;
  subheading?: string;
  light?: boolean;
  align?: 'left' | 'center';
}

const { label, heading, subheading, light = false, align = 'left' } = Astro.props;

const alignClass = align === 'center' ? 'text-center items-center' : 'text-left items-start';
---

<div class={`flex flex-col gap-3 mb-10 md:mb-14 ${alignClass}`}>
  <span class={light ? 'label-tag-light' : 'label-tag'}>{label}</span>
  <h2 class={`section-heading ${light ? 'text-white' : 'text-navy'} ${align === 'center' ? 'max-w-[700px]' : 'max-w-[640px]'}`}>
    {heading}
  </h2>
  {subheading && (
    <p class={`text-base md:text-lg leading-relaxed mt-1 ${light ? 'text-white/70' : 'text-muted'} ${align === 'center' ? 'max-w-[580px]' : 'max-w-[520px]'}`}>
      {subheading}
    </p>
  )}
</div>
