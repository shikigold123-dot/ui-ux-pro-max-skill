---
interface Props {
  heading: string;
  subheading?: string;
  ctaPrimary: { text: string; href: string };
  ctaSecondary?: { text: string; href: string };
}

const { heading, subheading, ctaPrimary, ctaSecondary } = Astro.props;
---

<section
  class="relative overflow-hidden section"
  style="background-color: #111D33;"
  aria-label="Handlungsaufforderung"
>
  <!-- Decorative dot pattern -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <svg class="absolute inset-0 w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="cta-dots" x="0" y="0" width="32" height="32" patternUnits="userSpaceOnUse">
          <circle cx="1" cy="1" r="1" fill="rgba(255,255,255,0.04)"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#cta-dots)"/>
    </svg>
  </div>

  <div class="container relative z-10 text-center">
    <!-- Thin rule above -->
    <div class="flex items-center gap-5 justify-center mb-10" aria-hidden="true">
      <div class="flex-1 max-w-[120px] h-px" style="background: rgba(255,255,255,0.1);"></div>
      <div class="w-1.5 h-1.5 rounded-full" style="background: rgba(255,255,255,0.2);"></div>
      <div class="flex-1 max-w-[120px] h-px" style="background: rgba(255,255,255,0.1);"></div>
    </div>

    <h2 class="section-heading text-white max-w-[700px] mx-auto">
      {heading}
    </h2>

    {subheading && (
      <p class="mt-5 text-base md:text-lg leading-relaxed max-w-[520px] mx-auto" style="color: rgba(255,255,255,0.65);">
        {subheading}
      </p>
    )}

    <div class="flex flex-wrap justify-center gap-3 mt-10">
      <a
        href={ctaPrimary.href}
        class="btn-primary bg-white text-navy border-white hover:bg-pearl hover:border-pearl"
      >
        {ctaPrimary.text}
      </a>
      {ctaSecondary && (
        <a href={ctaSecondary.href} class="btn-ghost-light">
          {ctaSecondary.text}
        </a>
      )}
    </div>
  </div>
</section>
