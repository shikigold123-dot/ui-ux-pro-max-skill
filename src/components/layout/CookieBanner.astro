---
---

<style>
  [x-cloak] { display: none !important; }
</style>

<div
  x-data="cookieBanner()"
  x-init="init()"
  x-show="visible"
  x-cloak
  x-transition:enter="transition ease-out duration-300"
  x-transition:enter-start="opacity-0 translate-y-4"
  x-transition:enter-end="opacity-100 translate-y-0"
  x-transition:leave="transition ease-in duration-200"
  x-transition:leave-start="opacity-100 translate-y-0"
  x-transition:leave-end="opacity-0 translate-y-4"
  class="fixed bottom-4 left-4 right-4 md:left-auto md:right-6 md:max-w-[480px] z-[100]"
  role="dialog"
  aria-modal="true"
  aria-label="Cookie-Einstellungen"
>
  <div class="bg-white rounded-2xl shadow-2xl border border-navy/10 p-6">
    <h2 class="font-serif font-bold text-navy text-lg mb-2">Ihre Privatsphäre</h2>
    <p class="text-sm text-muted leading-relaxed mb-5">
      Wir verwenden Cookies und ähnliche Technologien, um unsere Website zu betreiben und Ihnen bestmögliche Nutzungserfahrungen zu bieten. Einige sind technisch notwendig, andere helfen uns dabei, unsere Dienste zu verbessern.
      <a href="/datenschutz" class="text-navy underline underline-offset-2 hover:text-navy-light ml-1">Mehr erfahren</a>
    </p>

    <!-- Toggle Rows -->
    <div class="space-y-4 mb-6">

      <!-- Notwendig -->
      <div class="flex items-start justify-between gap-4">
        <div class="flex-1">
          <p class="text-sm font-medium text-navy">Notwendige Cookies</p>
          <p class="text-xs text-muted mt-0.5 leading-relaxed">Technisch erforderlich für Betrieb und Sicherheit der Website.</p>
        </div>
        <label class="cookie-toggle flex-shrink-0 mt-0.5" aria-label="Notwendige Cookies (immer aktiv)">
          <input type="checkbox" checked disabled aria-disabled="true" />
          <span class="cookie-toggle-slider"></span>
        </label>
      </div>

      <!-- Funktional -->
      <div class="flex items-start justify-between gap-4">
        <div class="flex-1">
          <p class="text-sm font-medium text-navy">Funktionale Cookies</p>
          <p class="text-xs text-muted mt-0.5 leading-relaxed">Ermöglichen Google Maps-Einbettungen auf der Kontaktseite.</p>
        </div>
        <label class="cookie-toggle flex-shrink-0 mt-0.5" aria-label="Funktionale Cookies">
          <input type="checkbox" x-model="prefs.functional" />
          <span class="cookie-toggle-slider"></span>
        </label>
      </div>

      <!-- Analyse -->
      <div class="flex items-start justify-between gap-4">
        <div class="flex-1">
          <p class="text-sm font-medium text-navy">Analyse-Cookies</p>
          <p class="text-xs text-muted mt-0.5 leading-relaxed">Derzeit keine Analyse-Tools implementiert.</p>
        </div>
        <label class="cookie-toggle flex-shrink-0 mt-0.5" aria-label="Analyse-Cookies">
          <input type="checkbox" x-model="prefs.analytics" />
          <span class="cookie-toggle-slider"></span>
        </label>
      </div>

    </div>

    <!-- Actions -->
    <div class="flex flex-col sm:flex-row gap-2.5">
      <button
        @click="acceptAll()"
        class="btn-primary flex-1 justify-center text-sm py-2.5 min-h-[44px]"
      >
        Alle akzeptieren
      </button>
      <button
        @click="savePrefs()"
        class="btn-ghost-dark flex-1 justify-center text-sm py-2.5 min-h-[44px]"
      >
        Auswahl speichern
      </button>
    </div>
    <div class="mt-3 text-center">
      <button
        @click="rejectAll()"
        class="text-xs text-muted hover:text-navy underline underline-offset-2 transition-colors"
      >
        Nur Notwendige
      </button>
    </div>
  </div>
</div>

<script>
  function cookieBanner() {
    return {
      visible: false,
      prefs: {
        necessary: true,
        functional: false,
        analytics: false,
      },
      init() {
        const stored = localStorage.getItem('axiom_cookie_consent');
        if (!stored) {
          setTimeout(() => { this.visible = true; }, 800);
        } else {
          try {
            const parsed = JSON.parse(stored);
            this.prefs = { ...this.prefs, ...parsed };
          } catch (_) {}
        }
      },
      save() {
        const data = {
          necessary: true,
          functional: this.prefs.functional,
          analytics: this.prefs.analytics,
          savedAt: new Date().toISOString(),
        };
        localStorage.setItem('axiom_cookie_consent', JSON.stringify(data));
        window.dispatchEvent(new CustomEvent('cookie-consent-saved', { detail: data }));
        this.visible = false;
      },
      acceptAll() {
        this.prefs.functional = true;
        this.prefs.analytics = true;
        this.save();
      },
      rejectAll() {
        this.prefs.functional = false;
        this.prefs.analytics = false;
        this.save();
      },
      savePrefs() {
        this.save();
      },
    };
  }

  document.addEventListener('alpine:init', () => {
    // @ts-ignore
    Alpine.data('cookieBanner', cookieBanner);
  });
</script>
