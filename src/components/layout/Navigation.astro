---
import { mainNav } from '../../data/navigation';
---

<style>
  [x-cloak] { display: none !important; }
</style>

<header
  x-data="navState()"
  x-init="init()"
  :class="scrolled ? 'bg-white shadow-sm' : 'bg-transparent'"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  role="banner"
>
  <div class="container">
    <div class="flex items-center justify-between h-[72px] gap-6">
      <!-- Logo -->
      <a
        href="/"
        class="flex items-center gap-3 no-underline group flex-shrink-0"
        aria-label="Axiom Medical Transfer — Startseite"
      >
        <div
          :class="scrolled ? 'border-navy' : 'border-white/70'"
          class="w-9 h-9 rounded-full border-2 flex items-center justify-center transition-colors duration-300 flex-shrink-0"
        >
          <span
            :class="scrolled ? 'text-navy' : 'text-white'"
            class="font-serif font-bold text-sm leading-none transition-colors duration-300"
          >A</span>
        </div>
        <div class="flex flex-col leading-none">
          <span
            :class="scrolled ? 'text-navy' : 'text-white'"
            class="font-sans font-semibold text-[0.8125rem] tracking-[0.15em] uppercase transition-colors duration-300"
          >AXIOM</span>
          <span
            :class="scrolled ? 'text-muted' : 'text-white/60'"
            class="font-sans font-normal text-[0.65rem] tracking-[0.08em] uppercase transition-colors duration-300"
          >Medical Transfer</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1" aria-label="Hauptnavigation">
        {mainNav.map((item) => (
          <a
            href={item.href}
            :class="scrolled ? 'text-navy hover:text-navy-light' : 'text-white/80 hover:text-white'"
            class="px-4 py-2 rounded-md font-sans font-medium text-sm transition-colors duration-200 no-underline"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Desktop CTA -->
      <a
        href="/kontakt"
        :class="scrolled ? 'bg-navy text-white hover:bg-navy-dark border-navy hover:border-navy-dark' : 'bg-white/10 text-white border-white/40 hover:bg-white/20 hover:border-white/70'"
        class="hidden md:inline-flex items-center gap-2 px-5 py-2.5 rounded-md border text-sm font-medium font-sans transition-all duration-200 no-underline flex-shrink-0"
      >
        Gespräch vereinbaren
      </a>

      <!-- Mobile Hamburger -->
      <button
        @click="menuOpen = !menuOpen"
        :aria-expanded="menuOpen"
        aria-label="Menü öffnen"
        class="md:hidden flex flex-col justify-center items-center w-10 h-10 gap-[5px] flex-shrink-0"
      >
        <span
          :class="menuOpen ? (scrolled ? 'bg-navy' : 'bg-white') + ' rotate-45 translate-y-[7px]' : (scrolled ? 'bg-navy' : 'bg-white')"
          class="block w-6 h-[2px] transition-all duration-300 origin-center"
        ></span>
        <span
          :class="menuOpen ? 'opacity-0' : (scrolled ? 'bg-navy' : 'bg-white')"
          class="block w-6 h-[2px] transition-all duration-300"
        ></span>
        <span
          :class="menuOpen ? (scrolled ? 'bg-navy' : 'bg-white') + ' -rotate-45 -translate-y-[7px]' : (scrolled ? 'bg-navy' : 'bg-white')"
          class="block w-6 h-[2px] transition-all duration-300 origin-center"
        ></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    x-show="menuOpen"
    x-cloak
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-2"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-2"
    class="md:hidden bg-white border-t border-navy/10 shadow-lg"
    @click.away="menuOpen = false"
  >
    <nav class="container py-4 flex flex-col gap-1" aria-label="Mobile Navigation">
      {mainNav.map((item) => (
        <a
          href={item.href}
          @click="menuOpen = false"
          class="px-4 py-3 rounded-md text-navy font-sans font-medium text-base hover:bg-pearl transition-colors no-underline"
        >
          {item.label}
        </a>
      ))}
      <div class="pt-3 mt-2 border-t border-navy/10">
        <a
          href="/kontakt"
          @click="menuOpen = false"
          class="btn-primary w-full justify-center"
        >
          Gespräch vereinbaren
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  function navState() {
    return {
      scrolled: false,
      menuOpen: false,
      init() {
        this.scrolled = window.scrollY > 60;
        window.addEventListener('scroll', () => {
          this.scrolled = window.scrollY > 60;
        }, { passive: true });
      },
    };
  }
  // Make available globally for Alpine
  document.addEventListener('alpine:init', () => {
    // @ts-ignore
    Alpine.data('navState', navState);
  });
</script>
